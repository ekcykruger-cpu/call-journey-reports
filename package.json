{
  "name": "call-journey-reports",
  "version": "0.1.0",
  "private": true,
  "description": "Reporting site for NICE CXone call journeys (report 540), hosted on Railway.",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "test": "npm test --workspaces --if-present"
  }
}
